#include <stdio.h>
#include <string.h>

int main()
{
    int n, i;
    char line[500];
    int macros = 0, headers = 0;

    printf("Enter number of lines: ");
    scanf("%d", &n);
    getchar();

    printf("Enter the C program:\n");

    for (i = 0; i < n; i++)
    {
        fgets(line, sizeof(line), stdin);

        if (strstr(line, "#define") != NULL)
            macros++;

        if (strstr(line, "#include") != NULL)
            headers++;
    }

    printf("\nNumber of Macros Defined = %d\n", macros);
    printf("Number of Header Files Included = %d\n", headers);

    return 0;
}
