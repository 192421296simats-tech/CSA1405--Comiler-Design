#include <stdio.h>
#include <string.h>

int main()
{
    char url[200];
    int i, valid = 1;

    printf("Enter URL: ");
    scanf("%s", url);

    if (strncmp(url, "http://", 7) != 0 &&
        strncmp(url, "https://", 8) != 0)
    {
        valid = 0;
    }

    if (valid)
    {
        int start;

        if (strncmp(url, "https://", 8) == 0)
            start = 8;
        else
            start = 7;

        if (url[start] == '\0')
            valid = 0;

        for (i = start; url[i] != '\0'; i++)
        {
            if (url[i] == ' ' || url[i] == '@')
            {
                valid = 0;
                break;
            }
        }

        if (strchr(url + start, '.') == NULL)
            valid = 0;
    }

    if (valid)
        printf("Valid URL\n");
    else
        printf("Invalid URL\n");

    return 0;
}
