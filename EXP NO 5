#include <stdio.h>

int main() {
    char str[1000];
    int i, spaces = 0, newlines = 0;

    printf("Enter the text:\n");
    fgets(str, sizeof(str), stdin);

    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] == ' ' || str[i] == '\t')
            spaces++;
        else if (str[i] == '\n')
            newlines++;
    }

    printf("Number of Whitespaces: %d\n", spaces);
    printf("Number of Newline Characters: %d\n", newlines);

    return 0;
}
