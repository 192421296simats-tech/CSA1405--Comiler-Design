#include <stdio.h>

int main()
{
    int day, month, year;

    printf("Enter DOB (DD/MM/YYYY): ");
    scanf("%d/%d/%d", &day, &month, &year);

    if (year >= 1900 && year <= 2026 &&
        month >= 1 && month <= 12 &&
        day >= 1 && day <= 31)
    {
        if ((month == 4 || month == 6 || month == 9 || month == 11) && day > 30)
            printf("Invalid DOB\n");
        else if (month == 2 && day > 29)
            printf("Invalid DOB\n");
        else
            printf("Valid DOB\n");
    }
    else
    {
        printf("Invalid DOB\n");
    }

    return 0;
}
