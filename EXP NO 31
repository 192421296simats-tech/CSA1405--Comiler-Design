#include <stdio.h>
#include <string.h>
#include <ctype.h>

int isKeyword(char word[])
{
    char keywords[][15] = {
        "int", "float", "char", "double", "if",
        "else", "for", "while", "do", "return",
        "void", "main", "printf", "scanf"
    };

    int n = sizeof(keywords) / sizeof(keywords[0]);
    int i;

    for (i = 0; i < n; i++)
    {
        if (strcmp(word, keywords[i]) == 0)
            return 1;
    }

    return 0;
}

int main()
{
    char str[1000], token[100];
    int i = 0, j;

    printf("Enter the C program:\n");
    printf("Enter END on a separate line to finish.\n\n");

    while (1)
    {
        fgets(str, sizeof(str), stdin);

        if (strcmp(str, "END\n") == 0 || strcmp(str, "END") == 0)
            break;

        i = 0;

        while (str[i] != '\0')
        {
            if (isspace(str[i]))
            {
                i++;
            }
            else if (isalpha(str[i]) || str[i] == '_')
            {
                j = 0;

                while (isalnum(str[i]) || str[i] == '_')
                    token[j++] = str[i++];

                token[j] = '\0';

                if (isKeyword(token))
                    printf("Keyword          : %s\n", token);
                else
                    printf("Identifier       : %s\n", token);
            }
            else if (isdigit(str[i]))
            {
                j = 0;

                while (isdigit(str[i]) || str[i] == '.')
                    token[j++] = str[i++];

                token[j] = '\0';

                printf("Constant         : %s\n", token);
            }
            else if (strchr("+-*/%=<>!", str[i]))
            {
                if ((str[i] == '=' || str[i] == '<' ||
                     str[i] == '>' || str[i] == '!') &&
                    str[i + 1] == '=')
                {
                    printf("Operator         : %c%c\n",
                           str[i], str[i + 1]);
                    i += 2;
                }
                else
                {
                    printf("Operator         : %c\n", str[i]);
                    i++;
                }
            }
            else if (strchr("();{},[]", str[i]))
            {
                printf("Special Symbol   : %c\n", str[i]);
                i++;
            }
            else
            {
                i++;
            }
        }
    }

    return 0;
}
