#include <stdio.h>
#include <string.h>

int main()
{
    char str[500];
    int i = 0;

    printf("Enter the input string: ");
    fgets(str, sizeof(str), stdin);

    while (str[i] != '\0')
    {
        if (str[i] == 'a' &&
            str[i + 1] == 'b' &&
            str[i + 2] == 'c')
        {
            printf("ABC");
            i += 3;
        }
        else
        {
            printf("%c", str[i]);
            i++;
        }
    }

    return 0;
}
