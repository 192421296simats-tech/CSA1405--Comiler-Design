#include <stdio.h>
#include <string.h>

int main()
{
    char com[30];
    int i = 2, a = 0;

    printf("Enter comment: ");
    fgets(com, sizeof(com), stdin);

    if(com[0] == '/')
    {
        if(com[1] == '/')
            printf("It is a comment");

        else if(com[1] == '*')
        {
            for(i = 2; com[i] != '\0'; i++)
            {
                if(com[i] == '*' && com[i+1] == '/')
                {
                    printf("It is a comment");
                    a = 1;
                    break;
                }
            }

            if(a == 0)
                printf("It is not a comment");
        }
        else
            printf("It is not a comment");
    }
    else
        printf("It is not a comment");

    return 0;
}
