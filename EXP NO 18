#include <stdio.h>
#include <string.h>

int main() {
    int n, i;
    char op1[20], op2[20], result[20], op[5];

    printf("Enter number of three address code statements: ");
    scanf("%d", &n);

    printf("Enter the three address code:\n");

    printf("\nGenerated Assembly Code:\n");

    for (i = 0; i < n; i++) {
        scanf("%s = %s %s %s", result, op1, op, op2);

        printf("MOV AX, %s\n", op1);

        if (strcmp(op, "+") == 0)
            printf("ADD AX, %s\n", op2);
        else if (strcmp(op, "-") == 0)
            printf("SUB AX, %s\n", op2);
        else if (strcmp(op, "*") == 0)
            printf("MUL %s\n", op2);
        else if (strcmp(op, "/") == 0)
            printf("DIV %s\n", op2);

        printf("MOV %s, AX\n\n", result);
    }

    return 0;
}
