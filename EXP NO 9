#include <stdio.h>
#include <string.h>

int main() {
    char nt;
    int n, i, j = 0, k = 0;
    char prod[10][50], alpha[10][50], beta[10][50];

    printf("Enter the non-terminal: ");
    scanf(" %c", &nt);

    printf("Enter number of productions: ");
    scanf("%d", &n);

    printf("Enter productions (without spaces):\n");
    for (i = 0; i < n; i++) {
        scanf("%s", prod[i]);
    }

    /* Separate alpha and beta */
    for (i = 0; i < n; i++) {
        if (prod[i][0] == nt) {
            strcpy(alpha[j++], prod[i] + 1);
        } else {
            strcpy(beta[k++], prod[i]);
        }
    }

    if (j == 0) {
        printf("\nNo left recursion found.\n");
    } else {
        printf("\nAfter eliminating left recursion:\n");

        printf("%c -> ", nt);
        for (i = 0; i < k; i++) {
            printf("%s%c'", beta[i], nt);
            if (i < k - 1)
                printf(" | ");
        }

        printf("\n%c' -> ", nt);
        for (i = 0; i < j; i++) {
            printf("%s%c'", alpha[i], nt);
            if (i < j - 1)
                printf(" | ");
        }
        printf(" | epsilon\n");
    }

    return 0;
}
