#include <stdio.h>
#include <string.h>
#include <ctype.h>

char expr[100];
int temp = 1;

void generate(char *s) {
    int i, j;
    char op, left, right;
    char t[10];

    while (strlen(s) > 1) {
        for (i = 0; i < strlen(s); i++) {
            if (s[i] == '*' || s[i] == '/') {
                op = s[i];
                left = s[i - 1];
                right = s[i + 1];

                printf("t%d = %c %c %c\n", temp, left, op, right);

                sprintf(t, "t%d", temp++);

                for (j = i - 1; j < strlen(s) - 2; j++)
                    s[j] = s[j + 3];

                s[i - 1] = t[0];
                break;
            }
        }

        if (i == strlen(s)) {
            for (i = 0; i < strlen(s); i++) {
                if (s[i] == '+' || s[i] == '-') {
                    op = s[i];
                    left = s[i - 1];
                    right = s[i + 1];

                    printf("t%d = %c %c %c\n",
                           temp, left, op, right);

                    sprintf(t, "t%d", temp++);

                    for (j = i - 1; j < strlen(s) - 2; j++)
                        s[j] = s[j + 3];

                    s[i - 1] = t[0];
                    break;
                }
            }
        }
    }
}

int main() {
    char lhs;

    printf("Enter the statement: ");
    scanf("%c = %s", &lhs, expr);

    printf("\nThree Address Code:\n");

    generate(expr);

    printf("%c = t%d\n", lhs, temp - 1);

    return 0;
}
