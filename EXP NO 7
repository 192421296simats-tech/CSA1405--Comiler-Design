#include <stdio.h>
#include <string.h>
#include <ctype.h>

char p[20][20];
int n;

void first(char c) {
    int i;

    for (i = 0; i < n; i++) {
        if (p[i][0] == c) {
            char x = p[i][2];

            if (x == '#')
                printf("# ");

            else if (!isupper(x))
                printf("%c ", x);

            else
                first(x);
        }
    }
}

int main() {
    int i;

    printf("Enter number of productions: ");
    scanf("%d", &n);

    printf("Enter productions (use # for epsilon):\n");

    for (i = 0; i < n; i++)
        scanf("%s", p[i]);

    printf("\nFIRST Sets:\n");

    for (i = 0; i < n; i++) {
        if (i == 0 || p[i][0] != p[i - 1][0]) {
            printf("FIRST(%c) = { ", p[i][0]);
            first(p[i][0]);
            printf("}\n");
        }
    }

    return 0;
}
