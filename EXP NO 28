#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char email[100];
    int i, at = 0, dot = 0, valid = 1;

    printf("Enter email address: ");
    scanf("%s", email);

    for (i = 0; email[i] != '\0'; i++)
    {
        if (email[i] == '@')
        {
            at++;

            if (i == 0 || email[i + 1] == '\0')
                valid = 0;
        }

        if (email[i] == '.')
        {
            dot++;

            if (i == 0 || email[i + 1] == '\0')
                valid = 0;
        }

        if (!(isalnum(email[i]) || email[i] == '@' ||
              email[i] == '.' || email[i] == '_' ||
              email[i] == '-'))
        {
            valid = 0;
        }
    }

    if (at != 1 || dot == 0)
        valid = 0;

    if (valid)
        printf("Valid Email Address\n");
    else
        printf("Invalid Email Address\n");

    return 0;
}
