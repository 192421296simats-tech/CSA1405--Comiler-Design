#include <stdio.h>
#include <string.h>
#include <ctype.h>

char p[20][20];
char followSet[20][20];
int n, count[20];

int indexOf(char c) {
    int i;
    for (i = 0; i < n; i++)
        if (p[i][0] == c)
            return i;
    return -1;
}

void add(int pos, char c) {
    int i;

    if (c == '#')
        return;

    for (i = 0; i < count[pos]; i++)
        if (followSet[pos][i] == c)
            return;

    followSet[pos][count[pos]++] = c;
}

void findFollow(char c) {
    int i, j, pos, next;

    pos = indexOf(c);

    if (c == p[0][0])
        add(pos, '$');

    for (i = 0; i < n; i++) {
        for (j = 2; p[i][j] != '\0'; j++) {

            if (p[i][j] == c) {

                if (p[i][j + 1] != '\0') {
                    next = indexOf(p[i][j + 1]);

                    if (next == -1)
                        add(pos, p[i][j + 1]);
                    else {
                        if (p[i][j + 1] == 'R' || p[i][j + 1] == 'Y') {
                            add(pos, '+');
                            add(pos, '*');
                        }
                    }
                }
                else if (p[i][0] != c) {
                    findFollow(p[i][0]);

                    next = indexOf(p[i][0]);

                    for (int k = 0; k < count[next]; k++)
                        add(pos, followSet[next][k]);
                }
            }
        }
    }
}

int main() {
    int i, j, found;

    printf("Enter number of productions: ");
    scanf("%d", &n);

    printf("Enter productions:\n");

    for (i = 0; i < n; i++)
        scanf("%s", p[i]);

    for (i = 0; i < n; i++)
        count[i] = 0;

    for (i = 0; i < n; i++)
        findFollow(p[i][0]);

    printf("\nFOLLOW Sets:\n");

    for (i = 0; i < n; i++) {
        found = 0;

        for (j = 0; j < i; j++) {
            if (p[i][0] == p[j][0]) {
                found = 1;
                break;
            }
        }

        if (!found) {
            int pos = indexOf(p[i][0]);

            printf("FOLLOW(%c) = { ", p[i][0]);

            for (j = 0; j < count[pos]; j++)
                printf("%c ", followSet[pos][j]);

            printf("}\n");
        }
    }

    return 0;
}
