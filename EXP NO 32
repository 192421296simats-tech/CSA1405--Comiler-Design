#include <stdio.h>
#include <ctype.h>

int main()
{
    char str[500];
    int i, count = 0;

    printf("Enter a sentence: ");
    fgets(str, sizeof(str), stdin);

    for (i = 0; str[i] != '\0'; i++)
    {
        if (tolower(str[i]) == 'a' ||
            tolower(str[i]) == 'e' ||
            tolower(str[i]) == 'i' ||
            tolower(str[i]) == 'o' ||
            tolower(str[i]) == 'u')
        {
            count++;
        }
    }

    printf("\nNumber of vowels = %d\n", count);

    return 0;
}
