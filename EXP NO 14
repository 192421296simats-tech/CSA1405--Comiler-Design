#include <stdio.h>
#include <string.h>

char stack[100], input[100];
int top = -1, ip = 0;

void display() {
    printf("\n%-15s %-15s", stack, input + ip);
}

int reduce() {
    /* E -> i */
    if (top >= 0 && stack[top] == 'i') {
        stack[top] = 'E';
        return 1;
    }

    /* E -> (E) */
    if (top >= 2 &&
        stack[top - 2] == '(' &&
        stack[top - 1] == 'E' &&
        stack[top] == ')') {
        top -= 2;
        stack[top] = 'E';
        return 1;
    }

    /* E -> E+E */
    if (top >= 2 &&
        stack[top - 2] == 'E' &&
        stack[top - 1] == '+' &&
        stack[top] == 'E') {
        top -= 2;
        stack[top] = 'E';
        return 1;
    }

    /* E -> E*E */
    if (top >= 2 &&
        stack[top - 2] == 'E' &&
        stack[top - 1] == '*' &&
        stack[top] == 'E') {
        top -= 2;
        stack[top] = 'E';
        return 1;
    }

    return 0;
}

int main() {
    printf("Enter the input string: ");
    scanf("%s", input);

    printf("\n%-15s %-15s Action", "Stack", "Input");
    printf("\n----------------------------------------");

    while (input[ip] != '\0') {
        /* SHIFT */
        stack[++top] = input[ip++];

        stack[top + 1] = '\0';

        printf("\n%-15s %-15s Shift",
               stack, input + ip);

        /* REDUCE whenever possible */
        while (reduce()) {
            stack[top + 1] = '\0';

            printf("\n%-15s %-15s Reduce",
                   stack, input + ip);
        }
    }

    /* Final reduction */
    while (reduce()) {
        stack[top + 1] = '\0';

        printf("\n%-15s %-15s Reduce",
               stack, input + ip);
    }

    if (top == 0 && stack[0] == 'E')
        printf("\n\nString is ACCEPTED.\n");
    else
        printf("\n\nString is REJECTED.\n");

    return 0;
}
